# AIO Tests Configuration
# Copy this file to .env and fill in your actual values

# Your Jira Cloud URL (e.g., https://yourcompany.atlassian.net)
AIO_JIRA_URL=https://yourcompany.atlassian.net

# AIO Tests API Key
# Generate this from: Jira Settings > Apps > AIO Tests > API Keys
AIO_API_KEY=your-api-key-here

# AIO Tests Project Key (e.g., PROJ)
AIO_PROJECT_KEY=YOUR_PROJECT_KEY

# Optional: Cycle ID to update (if not specified, a new cycle will be created)
# AIO_CYCLE_KEY=CYC-123
